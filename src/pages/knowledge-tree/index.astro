---
import Base from '../../layouts/Base.astro';
import TreeNav from '../../components/TreeNav.astro';
import Subscribe from '../../components/Subscribe.astro';
import { url } from '../../lib';
const sections = [
  { href: '/knowledge-tree/fruits/', title: 'Essays', tree: 'Fruits', blurb: 'Finished writing, published on my Substack.' },
  { href: '/knowledge-tree/branches/', title: 'Notes', tree: 'Branches', blurb: 'My slip-box represented as a knowledge graph. Where I write one idea per note, in my own words, linked into a graph.' },
  { href: '/knowledge-tree/roots/', title: 'References', tree: 'Roots', blurb: 'Books and sources I learn from, with my highlights. Where the ideas start.' },
];
---
<Base title="Knowledge Tree" section="knowledge">
  <div class="container">
    <TreeNav current="overview" />
    <p class="eyebrow">Knowledge Tree</p>
    <h1 class="page-title">Knowledge Tree</h1>
    <p class="page-lede">A public knowledge garden. I read and collect at the roots, connect ideas on the branches, and publish essays as fruits.</p>
    <div class="tree-split">
      <img class="tree-art" src={url('/knowledge-tree.jpg')} alt="Illustration of a tree with leaves, fruits and roots" width="1200" height="1200" />
      <ul class="tree-list">
        {sections.map((s) => (
          <li>
            <a href={url(s.href)}>
              <span class="eyebrow">{s.tree}</span>
              <h2>{s.title}</h2>
              <p>{s.blurb}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <Subscribe />
  </div>
</Base>
