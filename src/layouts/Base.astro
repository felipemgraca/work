---
import '../styles/global.css';
import { url, site } from '../lib';
import nav from '../data/nav.json';
interface Props { title?: string; description?: string; section?: string }
const { title, description = 'Felipe Graca: analytics, business intelligence and a public knowledge garden.', section = '' } = Astro.props;
const full = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname;
// One consistent link preview (WhatsApp, LinkedIn, etc.) for every page.
const shareDescription = 'Felipe Graca: analytics, business intelligence and a public knowledge garden.';
const shareImage = 'https://felipegraca.com/og-image.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="facebook-domain-verification" content="ezsmua13r2tl3d9ccuqwk54npbl78s" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={`https://felipegraca.com${path}`} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.name} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={shareImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="wordmark" href={url('/')} aria-label="Felipe Graca, home">Felipe Graca</a>
        <button type="button" class="nav-burger" id="nav-burger" aria-label="Menu" aria-expanded="false" aria-controls="primary-nav">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="b-open" d="M4 7h16M4 12h16M4 17h16"/><path class="b-close" d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <nav class="primary-nav" id="primary-nav" aria-label="Primary">
          <ul>
            <li><a class="nav-link" href={url(nav.tree.href)} aria-current={section === nav.tree.section ? 'page' : undefined}>{nav.tree.label}</a></li>
            {nav.links.map((l) => (
              <li><a class="nav-link" href={url(l.href)} aria-current={section === l.section ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <script>
      const burger = document.getElementById('nav-burger') as HTMLButtonElement;
      const primary = document.getElementById('primary-nav') as HTMLElement;
      burger.addEventListener('click', () => {
        const open = !primary.classList.contains('open');
        primary.classList.toggle('open', open);
        burger.classList.toggle('is-open', open);
        burger.setAttribute('aria-expanded', String(open));
      });
      const canHover = matchMedia('(hover: hover)').matches;
      const groups = Array.from(document.querySelectorAll('.has-menu')).map((li) => {
        const btn = li.querySelector('[data-menu-toggle]') as HTMLButtonElement;
        const menu = li.querySelector('.menu') as HTMLElement;
        const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); menu.hidden = !open; };
        btn.addEventListener('click', () => set(canHover ? true : menu.hidden));
        if (canHover) {
          li.addEventListener('mouseenter', () => set(true));
          li.addEventListener('mouseleave', () => set(false));
        }
        return { li, btn, set };
      });
      document.addEventListener('click', (e) => groups.forEach((g) => { if (!g.li.contains(e.target as Node)) g.set(false); }));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') groups.forEach((g) => { if (g.btn.getAttribute('aria-expanded') === 'true') { g.set(false); g.btn.focus(); } }); });
    </script>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <span>© 2026 Felipe Graca</span>
        <span>Built from my Obsidian vault</span>
      </div>
    </footer>
  </body>
</html>
